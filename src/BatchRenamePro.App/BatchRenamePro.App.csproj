<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BatchRenamePro</AssemblyName>
    <RootNamespace>BatchRenamePro.App</RootNamespace>
    <Description>批量文件改名 Pro — the desktop shell: live preview, rule pipeline editor and undo history.</Description>
    <Platforms>AnyCPU;x64;ARM64</Platforms>

    <!-- The UI is culture-aware by design: it ships zh-CN and en-US. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Nothing consumes the executable's XML docs, so do not demand them on every member. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- The DWM window attributes are set through [LibraryImport], whose generated marshalling
         stubs are unsafe by construction. No hand-written unsafe code exists in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    How a release is shipped, kept here rather than on the command line so a local publish and the
    one CI runs produce the same file. Naming a runtime is what opts in, so `dotnet build` and
    `dotnet run` are unaffected.

    Compression roughly halves the download — 155 MB to 68 MB — in exchange for a one-off
    decompression the first time it runs. WPF cannot be trimmed, so this is the only lever that
    moves the number, and for something people download once it is the right trade.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchRenamePro.Core\BatchRenamePro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The string tables are internal and should stay that way; the tests that check the two
         languages agree with each other need to read them all the same. -->
    <InternalsVisibleTo Include="BatchRenamePro.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand mark, shown on the About page and in the title bar. -->
    <Resource Include="Assets\app-256.png" />

    <!-- ApplicationIcon above stamps this onto the executable, which is what Explorer reads. The
         notification area needs it a second way: as a resource the process can open and pick a
         frame out of, since the file on disk is not reachable from a single-file publish. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
