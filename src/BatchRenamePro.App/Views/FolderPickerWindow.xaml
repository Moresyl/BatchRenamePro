<Window
    x:Class="BatchRenamePro.App.Views.FolderPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BatchRenamePro.App.Localization"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:BatchRenamePro.App.ViewModels"
    Title="{loc:T folderPicker.title}"
    Width="900"
    Height="580"
    Background="{DynamicResource Brush.Bg.Base}"
    FontFamily="{StaticResource Font.Family}"
    Foreground="{DynamicResource Brush.Text.Primary}"
    Icon="pack://application:,,,/BatchRenamePro;component/Assets/app-256.png"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">

    <!--
        NoResize rather than the shell window's CanMinimize: a modal dialog has nothing to minimize
        to. Between them they take away the resize border, the maximize box, and with it the caption
        double-click and the snap gestures that reach for it.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding
            Key="Up"
            Command="{Binding GoUpCommand}"
            Modifiers="Alt" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- A folder row: icon, then the name. Ticking one is how several folders get chosen at once. -->
        <DataTemplate x:Key="Folder.Row" DataType="{x:Type vm:FolderEntry}">
            <StackPanel Orientation="Horizontal">
                <Path
                    Width="{StaticResource Size.Icon}"
                    Height="{StaticResource Size.Icon}"
                    Data="{StaticResource Icon.Folder}"
                    Style="{StaticResource Icon.Accent}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Path}" />
            </StackPanel>
        </DataTemplate>

        <!--
            Selection lives on the entry rather than in the ListBox, so that the button at the bottom
            can say how many folders it is about to hand back without the view telling it.
        -->
        <Style
            x:Key="Folder.Container"
            BasedOn="{StaticResource {x:Type ListBoxItem}}"
            TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource Brush.Bg.Base}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==== Caption ================================================================== -->

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="{StaticResource Size.Icon.Small}"
                        Height="{StaticResource Size.Icon.Small}"
                        Data="{StaticResource Icon.Folder}"
                        Style="{StaticResource Icon.Accent}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Caption}"
                        Text="{loc:T folderPicker.title}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource Button.Window.Close}"
                    Tag="{StaticResource Icon.Window.Close}"
                    ToolTip="{loc:T window.close}" />
            </Grid>

            <!-- ==== Location bar ============================================================= -->

            <Grid Grid.Row="1" Margin="12,4,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Command="{Binding GoUpCommand}"
                    IsEnabled="{Binding CanGoUp}"
                    Style="{StaticResource Button.Icon}"
                    Tag="{StaticResource Icon.ChevronUp}"
                    ToolTip="{loc:T folderPicker.up}" />

                <!--
                    Typed and pasted paths are the fastest way into a deep folder, and the one thing
                    the shell dialog does well that a home-grown picker usually drops.
                -->
                <TextBox
                    x:Name="LocationBox"
                    Grid.Column="1"
                    Margin="6,0"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{loc:T folderPicker.location}"
                    KeyDown="OnLocationKeyDown"
                    Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Icon}"
                    Tag="{StaticResource Icon.Refresh}"
                    ToolTip="{loc:T folderPicker.refresh}" />
            </Grid>

            <!-- ==== Panes ==================================================================== -->

            <Grid Grid.Row="2" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Shortcuts -->
                <Border Style="{StaticResource Card}">
                    <DockPanel Margin="6">
                        <TextBlock
                            Margin="8,4,0,4"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Text.Caption}"
                            Text="{loc:T folderPicker.places}" />
                        <!-- One click, not two: a shortcut is a jump, not something you select. -->
                        <ListBox
                            x:Name="ShortcutList"
                            ItemTemplate="{StaticResource Folder.Row}"
                            ItemsSource="{Binding Shortcuts}"
                            SelectionChanged="OnShortcutSelected" />
                    </DockPanel>
                </Border>

                <!-- Folders -->
                <Border Grid.Column="1" Margin="8,0" Style="{StaticResource Card}">
                    <DockPanel Margin="6">
                        <TextBlock
                            Margin="8,4,0,4"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Text.Caption}"
                            Text="{loc:T folderPicker.folders}" />

                        <Grid>
                            <ListBox
                                x:Name="FolderList"
                                ItemContainerStyle="{StaticResource Folder.Container}"
                                ItemTemplate="{StaticResource Folder.Row}"
                                ItemsSource="{Binding Folders}"
                                MouseDoubleClick="OnFolderActivated"
                                SelectionMode="Extended" />

                            <TextBlock
                                Margin="10,6,0,0"
                                Text="{loc:T folderPicker.noFolders}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Folders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--
                    The reason the whole window exists. The shell's folder chooser will not list files,
                    so people cannot tell a folder of five hundred photos from an empty one until after
                    they have committed to it. Here it is just: this is what is in there.
                -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel Margin="6">
                        <TextBlock
                            Margin="8,4,0,4"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Text.Caption}"
                            Text="{Binding FileHeader}" />

                        <Grid>
                            <ItemsControl
                                ItemsSource="{Binding Files}"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,3" Orientation="Horizontal">
                                            <Path
                                                Width="{StaticResource Size.Icon.Small}"
                                                Height="{StaticResource Size.Icon.Small}"
                                                Data="{StaticResource Icon.File}"
                                                Style="{StaticResource Icon.Secondary}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Text.Secondary}"
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="10,6,0,0" Text="{loc:T folderPicker.noFiles}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==== Footer =================================================================== -->

            <Grid Grid.Row="3" Margin="12,10,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.Danger}"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding Message}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Message}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!--
                        Not IsCancel: that closes the window itself, and the second close arriving
                        from the command behind it would be setting DialogResult on a window that has
                        already gone. Escape is bound at the window instead.
                    -->
                    <Button
                        MinWidth="88"
                        Command="{Binding CancelCommand}"
                        Content="{loc:T action.cancel}" />
                    <Button
                        MinWidth="132"
                        Margin="8,0,0,0"
                        Command="{Binding AcceptCommand}"
                        Content="{Binding AcceptLabel}"
                        IsDefault="True"
                        Style="{StaticResource Button.Accent}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
