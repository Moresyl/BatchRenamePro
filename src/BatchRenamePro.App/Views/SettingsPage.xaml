<UserControl
    x:Class="BatchRenamePro.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BatchRenamePro.App.Localization"
    xmlns:planning="clr-namespace:BatchRenamePro.Core.Planning;assembly=BatchRenamePro.Core"
    xmlns:scanning="clr-namespace:BatchRenamePro.Core.Scanning;assembly=BatchRenamePro.Core"
    xmlns:services="clr-namespace:BatchRenamePro.App.Services"
    xmlns:vm="clr-namespace:BatchRenamePro.App.ViewModels">

    <UserControl.Resources>

        <!-- One setting: a label and its explanation on the left, the control on the right. -->
        <Style x:Key="Setting" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="Setting.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Setting.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border Margin="10,2,10,10" Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="12,10,12,8">
                <TextBlock Style="{StaticResource Text.Title}" Text="{loc:T settings.title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="{loc:T settings.subtitle}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Padding="12,0,8,12"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                    <!-- ==== Appearance ==== -->

                    <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T settings.section.appearance}" />
                    <Border Padding="12,9" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.checkUpdates}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.checkUpdates.hint}" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="1"
                                    AutomationProperties.Name="{loc:T settings.checkUpdates}"
                                    IsChecked="{Binding CheckForUpdatesOnStartup}"
                                    Style="{StaticResource Switch}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.minimizeToTray}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.minimizeToTray.hint}" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="1"
                                    AutomationProperties.Name="{loc:T settings.minimizeToTray}"
                                    IsChecked="{Binding MinimizeToTray}"
                                    Style="{StaticResource Switch}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.theme}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.theme.hint}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="156"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.theme}"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{loc:EnumSource {x:Type services:AppTheme}}"
                                    SelectedValue="{Binding Theme}"
                                    SelectedValuePath="Value" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}" IsEnabled="{x:Static vm:SettingsViewModel.BackdropAvailable}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.backdrop}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.backdrop.hint}" />
                                    <TextBlock
                                        Foreground="{DynamicResource Brush.Warning}"
                                        Style="{StaticResource Setting.Hint}"
                                        Text="{loc:T settings.backdrop.unavailable}"
                                        Visibility="{Binding Source={x:Static vm:SettingsViewModel.BackdropAvailable}, Converter={StaticResource BoolToVisibilityInverse}}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="156"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.backdrop}"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{loc:EnumSource {x:Type services:WindowBackdrop}}"
                                    SelectedValue="{Binding Backdrop}"
                                    SelectedValuePath="Value" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.language}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.language.hint}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="156"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.language}"
                                    DisplayMemberPath="NativeName"
                                    ItemsSource="{Binding Languages}"
                                    SelectedValue="{Binding Culture}"
                                    SelectedValuePath="Culture" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- ==== Renaming defaults ==== -->

                    <TextBlock
                        Margin="0,14,0,5"
                        Style="{StaticResource Text.Section}"
                        Text="{loc:T settings.section.defaults}" />
                    <Border Padding="12,9" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.confirmBeforeRun}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.confirmBeforeRun.hint}" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="1"
                                    AutomationProperties.Name="{loc:T settings.confirmBeforeRun}"
                                    IsChecked="{Binding ConfirmBeforeRun}"
                                    Style="{StaticResource Switch}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <!--
                                Above the two scan settings rather than below them, because it is the
                                first of the three that happens: you choose the folder, then it is
                                scanned, then what the scan found is named.
                            -->
                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.folderPicker}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.folderPicker.hint}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="156"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.folderPicker}"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{loc:EnumSource {x:Type services:FolderPickerStyle}}"
                                    SelectedValue="{Binding FolderPicker}"
                                    SelectedValuePath="Value" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.recursive}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.recursive.hint}" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="1"
                                    AutomationProperties.Name="{loc:T settings.recursive}"
                                    IsChecked="{Binding RecursiveByDefault}"
                                    Style="{StaticResource Switch}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.scanTarget}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="156"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.scanTarget}"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{loc:EnumSource {x:Type scanning:ScanTarget}}"
                                    SelectedValue="{Binding ScanTarget}"
                                    SelectedValuePath="Value" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.conflictPolicy}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.conflictPolicy.hint}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="156"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.conflictPolicy}"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{loc:EnumSource {x:Type planning:ConflictPolicy}}"
                                    SelectedValue="{Binding ConflictPolicy}"
                                    SelectedValuePath="Value" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==== Data ==== -->

                    <TextBlock
                        Margin="0,14,0,5"
                        Style="{StaticResource Text.Section}"
                        Text="{loc:T settings.section.data}" />
                    <Border Padding="12,9" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.historyLimit}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.historyLimit.hint}" />
                                </StackPanel>
                                <TextBox
                                    Grid.Column="1"
                                    Width="72"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="{loc:T settings.historyLimit}"
                                    Text="{Binding HistoryLimit}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.dataFolder}" />
                                    <TextBlock
                                        MaxWidth="380"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource Text.Mono}"
                                        Foreground="{DynamicResource Brush.Text.Tertiary}"
                                        Margin="0,2,0,0"
                                        Text="{Binding DataDirectory}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding DataDirectory}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenDataFolderCommand}"
                                    Content="{loc:T settings.openDataFolder}"
                                    Tag="{StaticResource Icon.Folder}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Setting}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Setting.Label}" Text="{loc:T settings.reset}" />
                                    <TextBlock Style="{StaticResource Setting.Hint}" Text="{loc:T settings.reset.hint}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{Binding ResetCommand}"
                                    Content="{loc:T settings.reset}"
                                    Style="{StaticResource Button.Danger}"
                                    Tag="{StaticResource Icon.Refresh}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
