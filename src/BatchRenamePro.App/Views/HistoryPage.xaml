<UserControl
    x:Class="BatchRenamePro.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BatchRenamePro.App.Localization"
    xmlns:views="clr-namespace:BatchRenamePro.App.Views"
    xmlns:vm="clr-namespace:BatchRenamePro.App.ViewModels">

    <Border Margin="0,0,16,16" Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="20,18,20,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Title}" Text="{loc:T history.title}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{loc:T history.subtitle}" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding ClearCommand}"
                    Content="{loc:T history.clear}"
                    Style="{StaticResource Button.Danger}"
                    Tag="{StaticResource Icon.Delete}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityInverse}}" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                Padding="20,0,14,20"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <!-- Named, or the row reads as "BatchRenamePro.App.ViewModels.HistoryEntry". -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryEntry}">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="16,14"
                                    Style="{StaticResource Card.Raised}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="38"
                                            Height="38"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.Bg.Subtle}"
                                            CornerRadius="{StaticResource Radius.Medium}">
                                            <Path
                                                Width="18"
                                                Height="18"
                                                Data="{StaticResource Icon.History}"
                                                Fill="{DynamicResource Brush.Text.Secondary}"
                                                Style="{StaticResource Icon}"
                                                HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Text.BodyStrong}"
                                                    Text="{Binding Title}" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Text.Caption}"
                                                    Text="{Binding CompletedAt, Converter={StaticResource RelativeTime}}"
                                                    ToolTip="{Binding CompletedAt}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,5,0,0"
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding Location}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,5,0,0"
                                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                                Style="{StaticResource Text.Mono}"
                                                Text="{Binding Sample}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=views:HistoryPage}}"
                                                CommandParameter="{Binding}"
                                                Content="{loc:T action.undo}"
                                                Tag="{StaticResource Icon.Undo}" />
                                            <Button
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=views:HistoryPage}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Icon}"
                                                Tag="{StaticResource Icon.Clear}"
                                                ToolTip="{loc:T history.forget}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Margin="0,70,0,0"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Path
                            Width="48"
                            Height="48"
                            Margin="0,0,0,18"
                            Data="{StaticResource Icon.History}"
                            Fill="{DynamicResource Brush.Text.Disabled}"
                            Style="{StaticResource Icon}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Subtitle}"
                            Text="{loc:T history.empty.title}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Secondary}"
                            Text="{loc:T history.empty.hint}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
