<Window
    x:Class="BatchRenamePro.App.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BatchRenamePro.App.Localization"
    xmlns:services="clr-namespace:BatchRenamePro.App.Services"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:BatchRenamePro.App.Views"
    xmlns:vm="clr-namespace:BatchRenamePro.App.ViewModels"
    Title="{loc:T app.name}"
    Width="1000"
    Height="640"
    Background="{DynamicResource Brush.Bg.Base}"
    FontFamily="{StaticResource Font.Family}"
    Foreground="{DynamicResource Brush.Text.Primary}"
    Icon="pack://application:,,,/Assets/app-256.png"
    ResizeMode="CanMinimize"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <!--
        The window draws its own title bar so the navigation tabs can sit in the caption strip beside
        the title, the way Explorer and Edge do, instead of costing a band of their own below it.
        GlassFrameThickness is left at zero: the backdrop is applied through DWM in code-behind, and
        a glass frame on top of it would double up the material.

        CanMinimize rather than NoResize. Both take away the resize border and the maximize box — and
        with the maximize box goes everything that reaches for it behind your back: double-clicking
        the caption, Win+Up, and dragging the window against the top of the screen. NoResize would
        also take away the minimize box, and minimizing is how this application goes to the
        notification area. So: no growing, no maximizing, still minimizes.

        ResizeBorderThickness is zero to match. WindowChrome stops answering the resize hit-tests once
        the window is fixed, but a six-pixel band along every edge that quietly swallows clicks is not
        something to leave lying around on the strength of that.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!--
            A tab. Neither the label nor the icon carries a style of its own: both inherit from the
            container, which is what lets the selected tab darken its text and thicken its weight
            without the template knowing anything about selection.
        -->
        <DataTemplate x:Key="Nav.Template" DataType="{x:Type vm:NavigationItem}">
            <StackPanel Orientation="Horizontal">
                <Path
                    Width="{StaticResource Size.Icon}"
                    Height="{StaticResource Size.Icon}"
                    Data="{Binding IconKey, Converter={StaticResource Resource}}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Style="{StaticResource Icon}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding TitleCode, Converter={StaticResource Localize}}" />
            </StackPanel>
        </DataTemplate>

        <!--
            The tab's own container. Without an explicit name a screen reader falls back to the bound
            record's ToString(), so the title is stated here outright and stays correct in both
            languages. No tooltip: the label is right there, and repeating it is noise.
        -->
        <Style x:Key="Nav.Entry" BasedOn="{StaticResource Nav.Item}" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding TitleCode, Converter={StaticResource Localize}}" />
        </Style>

        <!--
            What right-clicking the notification-area icon offers. While the window is hidden this
            menu and a click on the icon are the only ways back into the application, so showing it
            comes first; quitting is separated by a rule because it is the one item here that loses
            work. Both items are handled in code-behind rather than bound to commands: neither is a
            document operation, and the menu is opened from a Win32 message with no data context.
        -->
        <ContextMenu x:Key="Tray.Menu">
            <MenuItem
                Click="OnTrayShow"
                Header="{loc:T tray.show}"
                Icon="{StaticResource Icon.Window.Restore}" />
            <Separator />
            <MenuItem
                Click="OnTrayExit"
                Header="{loc:T tray.exit}"
                Icon="{StaticResource Icon.Window.Close}" />
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Brush.Bg.Base}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==== Title bar ================================================================= -->

            <!--
                Identity, then the tabs, then the window buttons — one strip doing the work of the
                three bands this used to take. Everything clickable in here declares itself hit-test
                visible, because the chrome's caption band is a drag handle by default and would
                otherwise swallow the clicks before they reached a tab.
            -->
            <Grid Height="{StaticResource Size.Caption}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="15"
                        Height="15"
                        Margin="0,0,7,0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/Assets/app-256.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Style="{StaticResource Text.Caption}"
                        Text="{loc:T app.name}" />
                    <Border
                        Width="1"
                        Height="14"
                        Margin="10,0,4,0"
                        Background="{DynamicResource Brush.Stroke.Default}" />
                </StackPanel>

                <ListBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ItemContainerStyle="{StaticResource Nav.Entry}"
                    ItemTemplate="{StaticResource Nav.Template}"
                    ItemsSource="{x:Static vm:ShellViewModel.PrimaryNavigation}"
                    SelectedValue="{Binding Page}"
                    SelectedValuePath="Page"
                    Style="{StaticResource Nav.Strip}" />

                <ListBox
                    Grid.Column="3"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ItemContainerStyle="{StaticResource Nav.Entry}"
                    ItemTemplate="{StaticResource Nav.Template}"
                    ItemsSource="{x:Static vm:ShellViewModel.SecondaryNavigation}"
                    SelectedValue="{Binding Page}"
                    SelectedValuePath="Page"
                    Style="{StaticResource Nav.Strip}" />

                <StackPanel
                    Grid.Column="4"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="{Binding Update.BadgeText}"
                        Command="{Binding Update.OpenReleaseCommand}"
                        Style="{StaticResource Button.Window}"
                        Tag="{StaticResource Icon.Refresh}"
                        ToolTip="{Binding Update.BadgeText}"
                        Visibility="{Binding Update.ShowBadge, Converter={StaticResource BoolToVisibility}}" />

                    <!-- The glyph shows where the click goes, not where it is: dark theme, sun. -->
                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="{loc:T action.toggleTheme}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource Button.Window}" TargetType="Button">
                                <Setter Property="Tag" Value="{StaticResource Icon.Moon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDark}" Value="True">
                                        <Setter Property="Tag" Value="{StaticResource Icon.Sun}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--
                        No maximize button between these two. The window is a fixed size on purpose,
                        and a button that cannot do the thing it draws is worse than no button.
                    -->
                    <Button
                        Click="OnMinimize"
                        Style="{StaticResource Button.Window}"
                        Tag="{StaticResource Icon.Window.Minimize}"
                        ToolTip="{loc:T window.minimize}" />
                    <Button
                        Click="OnClose"
                        Style="{StaticResource Button.Window.Close}"
                        Tag="{StaticResource Icon.Window.Close}"
                        ToolTip="{loc:T window.close}" />
                </StackPanel>
            </Grid>

            <!-- ==== Pages ==================================================================== -->

            <!--
                Every page stays alive and merely hides, which is what keeps a half-built rule
                pipeline, a scroll position and an expanded card intact across a trip to Settings.
                The pages are cheap; rebuilding the user's train of thought is not.
            -->
            <Grid Grid.Row="1">
                <views:RenamePage
                    DataContext="{Binding Rename}"
                    Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Rename}" />
                <views:PresetsPage
                    DataContext="{Binding Rename}"
                    Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Presets}" />
                <views:HistoryPage
                    DataContext="{Binding History}"
                    Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=History}" />
                <views:SettingsPage
                    DataContext="{Binding Settings}"
                    Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Settings}" />
                <views:AboutPage
                    DataContext="{Binding About}"
                    Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=About}" />
            </Grid>

            <!-- ==== Toasts =================================================================== -->

            <ItemsControl
                Grid.Row="1"
                Margin="0,0,16,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                ItemsSource="{Binding Notifications.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:Notification}">
                        <Border
                            MinWidth="260"
                            MaxWidth="380"
                            Margin="0,6,0,0"
                            Padding="11,9"
                            Background="{DynamicResource Brush.Bg.Flyout}"
                            BorderBrush="{DynamicResource Brush.Stroke.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Large}"
                            Effect="{DynamicResource Effect.Shadow.Flyout}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Slide" X="24" />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Slide"
                                                Storyboard.TargetProperty="X"
                                                To="0"
                                                Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path
                                    x:Name="Glyph"
                                    Width="{StaticResource Size.Icon}"
                                    Height="{StaticResource Size.Icon}"
                                    Margin="0,1,9,0"
                                    VerticalAlignment="Top"
                                    Data="{StaticResource Icon.Info}"
                                    Fill="{DynamicResource Brush.Info}"
                                    Style="{StaticResource Icon}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Body}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />

                                <Button
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding InvokeCommand}"
                                    Content="{Binding ActionLabel}"
                                    Style="{StaticResource Button.Link}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />

                                <Button
                                    Grid.Column="3"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DismissCommand}"
                                    Style="{StaticResource Button.Icon.Small}"
                                    Tag="{StaticResource Icon.Window.Close}" />
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Success}">
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Success}" />
                                <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Warning}">
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                                <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Error}">
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Error}" />
                                <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ==== Modal dialog ============================================================== -->

            <Grid
                Grid.RowSpan="2"
                Background="{DynamicResource Brush.Bg.Scrim}"
                Visibility="{Binding Dialogs.Current, Converter={StaticResource NullToVisibility}}">
                <ContentControl
                    Width="384"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding Dialogs.Current}"
                    Focusable="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type services:DialogRequest}">
                            <Border
                                Padding="18,15"
                                Background="{DynamicResource Brush.Bg.Flyout}"
                                BorderBrush="{DynamicResource Brush.Stroke.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.XLarge}"
                                Effect="{DynamicResource Effect.Shadow.Flyout}">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,9" Orientation="Horizontal">
                                        <Path
                                            x:Name="Glyph"
                                            Width="17"
                                            Height="17"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource Icon.Question}"
                                            Fill="{DynamicResource Brush.Accent.Default}"
                                            Style="{StaticResource Icon}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Subtitle}"
                                            Text="{Binding Title}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource Text.Secondary}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />

                                    <TextBox
                                        x:Name="Input"
                                        Margin="0,10,0,0"
                                        Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsInput, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <Button
                                            MinWidth="78"
                                            Margin="0,0,6,0"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding CancelCommand}"
                                            Content="{Binding CancelLabel}"
                                            IsCancel="True"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            x:Name="Confirm"
                                            MinWidth="78"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ConfirmCommand}"
                                            Content="{Binding ConfirmLabel}"
                                            IsDefault="True"
                                            Style="{StaticResource Button.Accent}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DialogKind.Success}">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Success}" />
                                    <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DialogKind.Warning}">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                                    <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DialogKind.Error}">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Error}" />
                                    <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                    <Setter TargetName="Confirm" Property="Style" Value="{StaticResource Button.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
