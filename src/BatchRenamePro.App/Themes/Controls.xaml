<!--
    The control library.

    Every style here is built from the palette tokens and nothing else — search this file for a hex
    colour and you should find none. Palette brushes are referenced with DynamicResource because
    ThemeService swaps the palette dictionary underneath a running window; a StaticResource would
    freeze the first theme in place and only fix itself on restart.

    Icons.xaml is merged in here rather than in App.xaml: a StaticResource inside a merged dictionary
    cannot see a sibling dictionary, only its own and the ones it merges itself. Views still reach the
    icons through the normal element-tree lookup.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BatchRenamePro.App.Controls"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==== Metrics ========================================================================= -->

    <!--
        Every size in the application resolves to one of these. They are gathered here rather than
        written into the styles because density is a single decision, not fifty: the tool is meant to
        sit next to a file manager while you work, so it is built at the density of a Windows dialog
        — a 28px control, a 22px row, a 12px face — not at the airy scale of a full-screen app. That
        only holds if there is one place to change it, and nothing hard-codes a number behind its
        back.
    -->

    <CornerRadius x:Key="Radius.Small">3</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">4</CornerRadius>
    <CornerRadius x:Key="Radius.Large">6</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">8</CornerRadius>

    <!--
        There is deliberately no Radius.Pill. WPF does not clamp a CornerRadius to half the side it
        sits on the way CSS does — give a 6px-wide scroll thumb a radius of 999 and the four arcs
        overrun each other, and what draws is a lens, not a capsule. That is where the bowed scroll
        bar and the bowed switch came from. A capsule is therefore written as half its own height at
        the one place that knows the height, and each of those sites says so.
    -->

    <!-- Heights. Control is what a button, text box and combo box all share, so they line up in a
         row without anyone setting a height by hand. -->
    <sys:Double x:Key="Size.Control">28</sys:Double>
    <sys:Double x:Key="Size.Control.Small">22</sys:Double>
    <sys:Double x:Key="Size.Row">22</sys:Double>
    <sys:Double x:Key="Size.Caption">32</sys:Double>
    <sys:Double x:Key="Size.Tab">30</sys:Double>

    <sys:Double x:Key="Size.Icon">14</sys:Double>
    <sys:Double x:Key="Size.Icon.Small">11</sys:Double>
    <sys:Double x:Key="Size.Check">16</sys:Double>

    <!-- Type ramp. 12 is the Windows shell's own body size (9pt); everything else is placed
         relative to it, and only the page title is allowed to be large. -->
    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.Body">12</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">14</sys:Double>
    <sys:Double x:Key="Font.Size.Title">19</sys:Double>

    <!-- Spacing. Panel is the inset of a panel's content from its edge; Control is the inset of a
         control's text from its border. -->
    <Thickness x:Key="Pad.Control">8,0</Thickness>
    <Thickness x:Key="Pad.Panel">10</Thickness>
    <Thickness x:Key="Pad.Panel.Tight">8</Thickness>

    <!-- ==== Typography ======================================================================= -->

    <!--
        Segoe UI Variable is the Windows 11 face; Segoe UI covers Windows 10; Microsoft YaHei UI
        carries the Chinese text on both. WPF walks this list per glyph, so a mixed-script string
        picks up the right face for each character without any per-culture switching.
    -->
    <FontFamily x:Key="Font.Family">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Family.Display">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>

    <!-- The label above a group of settings: small and semi-bold rather than large. -->
    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    </Style>

    <!-- ==== Focus =========================================================================== -->

    <!--
        The Windows 11 focus ring: a dark line with a light one inside it, so the same rectangle is
        visible whether the control sits on a pale card or a dark one.
    -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-2">
                        <Border
                            BorderBrush="{DynamicResource Brush.Stroke.Focus}"
                            BorderThickness="2"
                            CornerRadius="5"
                            SnapsToDevicePixels="True" />
                        <Border
                            Margin="2"
                            BorderBrush="{DynamicResource Brush.Stroke.FocusInner}"
                            BorderThickness="1"
                            CornerRadius="3"
                            SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Icons =========================================================================== -->

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Size.Icon}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Icon.Secondary" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Icon.Accent" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Default}" />
    </Style>

    <!-- ==== Buttons ========================================================================= -->

    <!--
        One template for every button in the application. An optional leading glyph comes from Tag,
        which keeps `<Button Tag="{StaticResource Icon.Add}" Content="Add"/>` to a single line and
        makes the glyph follow Foreground through every state without a second brush to maintain.
    -->
    <ControlTemplate x:Key="Button.Template" TargetType="ButtonBase">
        <Border
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Medium}"
            SnapsToDevicePixels="True">
            <StackPanel
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Path
                    x:Name="Glyph"
                    Margin="0,0,6,0"
                    Data="{TemplateBinding Tag}"
                    Fill="{TemplateBinding Foreground}"
                    Style="{StaticResource Icon}" />
                <ContentPresenter
                    x:Name="Label"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"
                    SnapsToDevicePixels="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Margin" Value="0" />
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlPressed}" />
                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Subtle}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        A button whose face is an icon has no text for a screen reader to read, so it would be
        announced as an anonymous "button". Its tooltip is already the label a sighted user gets on
        hover, so it is bound through as the accessible name as well and the two can never drift
        apart. Buttons that carry visible text have no tooltip; the binding then yields null, which
        leaves the name unset and the automation peer falls back to the content, as verified against
        the live tree.
    -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- The bare toggles — rule picker, filter, token picker — draw their own template and so take
         no other style; this gives them the same tooltip-as-label treatment. -->
    <Style TargetType="ToggleButton">
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- The one button on a page that does the thing the page exists for. -->
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Radius.Medium}"
                        SnapsToDevicePixels="True">
                        <StackPanel
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Path
                                x:Name="Glyph"
                                Margin="0,0,8,0"
                                Data="{TemplateBinding Tag}"
                                Fill="{TemplateBinding Foreground}"
                                Style="{StaticResource Icon}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill until you point at it. For toolbars, where a row of framed buttons would be noise. -->
    <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="Width" Value="{StaticResource Size.Control}" />
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Button.Icon.Small" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Small}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Small}" />
    </Style>

    <!--
        Destructive actions read as danger-coloured text on a tinted plate rather than a solid red
        block: the same style then works in both palettes without inverting its own label.
    -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Stroke}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Accent}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <TextBlock
                        x:Name="Label"
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding Content}"
                        TextDecorations="{x:Null}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Window buttons ================================================================== -->

    <Style x:Key="Button.Window" TargetType="Button">
        <!-- 46x32 is what every Windows 11 caption strip uses, so the buttons land where the muscle
             memory expects them and the hover plates line up with the ones next door. -->
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="{StaticResource Size.Caption}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Path
                            x:Name="Glyph"
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding Tag}"
                            Fill="{TemplateBinding Foreground}"
                            SnapsToDevicePixels="True"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtlePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red on hover, as every Windows window has done since 8. -->
    <Style x:Key="Button.Window.Close" TargetType="Button" BasedOn="{StaticResource Button.Window}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Path
                            x:Name="Glyph"
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding Tag}"
                            Fill="{TemplateBinding Foreground}"
                            SnapsToDevicePixels="True"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FFC42B1C" />
                            <Setter TargetName="Glyph" Property="Fill" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FFB2271A" />
                            <Setter TargetName="Glyph" Property="Fill" Value="#FFFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Toggle switch =================================================================== -->

    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Track"
                        Width="32"
                        Height="16"
                        Background="{DynamicResource Brush.Bg.Control}"
                        BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <!--
                            The thumb travels by margin, not by a render transform, and the checked
                            trigger below sets that margin as well as animating it. A transform
                            would be cheaper, but its resting position could only be established by
                            the storyboard — and EnterActions fire on a transition, never on a
                            state that was already true when the template was applied. A switch
                            bound to a setting that loads enabled would come up blue with the thumb
                            still on the left. Margin is one property, so the Setter answers for the
                            state and the animation only for the journey between states.
                        -->
                        <Ellipse
                            x:Name="Thumb"
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Left"
                            Margin="3,0,0,0"
                            Fill="{DynamicResource Brush.Text.Secondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.Text.OnAccent}" />

                            <!--
                                Track 32 wide less two 1px borders leaves 30; a 9px thumb inset 3
                                from the right edge sits at a left margin of 18.
                            -->
                            <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            From="3,0,0,0"
                                            To="18,0,0,0"
                                            Duration="0:0:0.16">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            From="18,0,0,0"
                                            To="3,0,0,0"
                                            Duration="0:0:0.16">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="11" />
                            <Setter TargetName="Thumb" Property="Height" Value="11" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Check box ======================================================================= -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Border
                            x:Name="Box"
                            Width="{StaticResource Size.Check}"
                            Height="{StaticResource Size.Check}"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Bg.Control}"
                            BorderBrush="{DynamicResource Brush.Stroke.Strong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Small}"
                            SnapsToDevicePixels="True">
                            <Path
                                x:Name="Tick"
                                Width="9"
                                Height="9"
                                Data="{StaticResource Icon.Check}"
                                Fill="{DynamicResource Brush.Text.OnAccent}"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter
                            x:Name="Label"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Segmented radio ================================================================= -->

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Small}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
                            <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Effect.Shadow.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tray a row of Segment buttons sits in. -->
    <Style x:Key="Segment.Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Subtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ==== Text input ====================================================================== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent.Default}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContextMenu" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <!--
                            The 1px accent line under a focused box, which is the Windows 11 signal
                            that typing goes here. It is drawn over the border rather than replacing
                            it so the box does not change size on focus.
                        -->
                        <Border
                            x:Name="Underline"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Margin="1,0,1,0"
                            Background="{DynamicResource Brush.Accent.Default}"
                            CornerRadius="0,0,3,3"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="Placeholder"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.Tertiary}"
                            IsHitTestVisible="False"
                            Text="{Binding Path=(controls:Hint.Text), RelativeSource={RelativeSource TemplatedParent}}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Base}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextBox.Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    </Style>

    <!-- ==== Combo box ======================================================================= -->

    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Root"
                        Margin="4,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Small}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border
                                x:Name="Marker"
                                Width="3"
                                Height="12"
                                Margin="-5,0,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Accent.Default}"
                                CornerRadius="1.5"
                                Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Selected}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <!-- A combo box has no text of its own to fall back on: read out its tooltip when it has
             one. Where it does not, the page states the name outright next to its visible label. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False" />
                                <Path
                                    x:Name="Chevron"
                                    Grid.Column="1"
                                    Width="9"
                                    Height="9"
                                    Margin="0,0,8,0"
                                    Data="{StaticResource Icon.ChevronDown}"
                                    Fill="{DynamicResource Brush.Text.Secondary}"
                                    IsHitTestVisible="False"
                                    Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <ToggleButton
                            x:Name="Toggle"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource ComboBox.Toggle}" />

                        <Popup
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade"
                            VerticalOffset="4">
                            <Border
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="8"
                                Padding="0,4"
                                Background="{DynamicResource Brush.Bg.Flyout}"
                                BorderBrush="{DynamicResource Brush.Stroke.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Large}"
                                Effect="{DynamicResource Effect.Shadow.Flyout}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.ControlDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Rule editor fields ============================================================== -->

    <!--
        The scaffolding every rule editor is built from: a labelled field, a check, a number box,
        an enum picker. They live here rather than beside the editors that use them because each
        one has to derive from the themed base style for its type, and BasedOn only accepts a
        StaticResource — which, from a sibling dictionary, cannot see these implicit styles.
        Declared there, a keyed ComboBox style would silently replace the whole theme with the
        stock WPF one, and the rule cards would be wearing a different decade's controls.
    -->

    <Style x:Key="Field" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Field.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="2,0,0,3" />
    </Style>

    <Style x:Key="Field.Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Field.Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="64" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Every enum picker in the rule editors: value in, localized label out. -->
    <Style x:Key="Field.Enum" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="DisplayMemberPath" Value="Text" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>

    <!-- ==== Scroll bars ===================================================================== -->

    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- The bar is 10 wide and the margin takes 2 off each side, so the thumb is 6:
                         a radius of 3 is the capsule, and anything larger bows it. -->
                    <Border
                        Margin="2"
                        Background="{DynamicResource Brush.Text.Tertiary}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A thin overlay bar with no arrow buttons. Repeat buttons stay in the template — they are what
        makes clicking the empty half of the track page up and down — but they draw nothing.
    -->
    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.Page}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.Page}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border x:Name="Root" Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.Page}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.Page}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Subtle}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==== Lists =========================================================================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource Radius.Large}">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Margin="0,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Medium}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A table row rather than a list entry: tighter, and with no vertical gap between containers
        so that a run of selected rows reads as one block instead of a dotted line of them.
    -->
    <Style
        x:Key="Row"
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Small}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Navigation tabs ================================================================= -->

    <!--
        A horizontal tab rather than a vertical rail. A rail costs 56px of width before it has shown
        anything and pushes the whole layout rightwards; five destinations do not need that. This is
        the Windows 11 pivot: text on a transparent plate, a short accent bar under the selected one,
        and nothing drawn around it.
    -->
    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Height" Value="{StaticResource Size.Tab}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="1,0">
                        <Border
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True" />
                        <ContentPresenter
                            Margin="9,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                        <!-- The bar under the selected tab. Inset so it spans the label, not the
                             whole hit target, which is what makes a row of tabs read as a row. -->
                        <Border
                            x:Name="Marker"
                            Height="2"
                            Margin="9,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Brush.Accent.Default}"
                            CornerRadius="1"
                            Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The strip the tabs sit in. The stock list template wraps its items in a ScrollViewer, which
        is the wrong container for five tabs in a title bar: it would clip them before the window is
        anywhere near its minimum width. This lays them out and nothing else.
    -->
    <Style x:Key="Nav.Strip" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.Item}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Surfaces ======================================================================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card.Raised" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect" Value="{DynamicResource Effect.Shadow.Card}" />
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Layer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XLarge}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Stroke.Divider}" />
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!-- ==== Status chips ==================================================================== -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Padding 1 top and bottom around an 11px caption line, plus the border, comes to 19. -->
        <Setter Property="CornerRadius" Value="9.5" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Chip.Success" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Stroke}" />
    </Style>

    <Style x:Key="Chip.Warning" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Stroke}" />
    </Style>

    <Style x:Key="Chip.Danger" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Stroke}" />
    </Style>

    <Style x:Key="Chip.Info" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info.Stroke}" />
    </Style>

    <!-- ==== Progress ======================================================================== -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- The bar is 3 tall, so 1.5 rounds the ends and nothing more. -->
                    <Border
                        x:Name="Track"
                        Background="{TemplateBinding Background}"
                        CornerRadius="1.5"
                        SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border
                                x:Name="PART_Track"
                                Background="Transparent" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="1.5" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Tooltips ======================================================================== -->

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Margin="6"
                        Padding="8,4"
                        Background="{DynamicResource Brush.Bg.Flyout}"
                        BorderBrush="{DynamicResource Brush.Stroke.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Effect="{DynamicResource Effect.Shadow.Flyout}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Context menus =================================================================== -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Margin="8"
                        Padding="0,4"
                        Background="{DynamicResource Brush.Bg.Flyout}"
                        BorderBrush="{DynamicResource Brush.Stroke.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Large}"
                        Effect="{DynamicResource Effect.Shadow.Flyout}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="Root"
                        Margin="4,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Small}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                x:Name="Glyph"
                                Margin="0,0,8,0"
                                Data="{TemplateBinding Icon}"
                                Fill="{DynamicResource Brush.Text.Secondary}"
                                Style="{StaticResource Icon}" />
                            <ContentPresenter
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource Brush.Stroke.Divider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
